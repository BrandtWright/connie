# connie repository .gitignore

# Claude Code local settings (personal overrides, not for sharing)
.claude/settings.local.json

# macOS
.DS_Store

# Editor artifacts
.idea/
*.swp
*.swo

# VSCode: ignore personal settings but allow shared workspace settings
# (extensions.json recommends extensions; settings.json sets shellcheck
# dialect and similar project-level defaults).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
