# https://editorconfig.org — editor-agnostic mirror of .vscode/settings.json
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML is conventionally 2-space indented (config + compose files).
[*.{yml,yaml}]
indent_size = 2

# Makefile recipes require real tabs.
[Makefile]
indent_style = tab
