#!/usr/bin/env sh
# connie — run Claude Code in a constrained, reproducible container
# POSIX sh — no bashisms
#
# ── Function index ───────────────────────────────────────────────────────────
#
# A flat ToC by section. Names only (line numbers drift); use your
# editor's "go to symbol" or `grep -n '^name(' src/connie` to jump.
#
#   Utilities ──────────────────  _die _info _detail _debug _confirm _require
#                                  _require_yq _usage _launch_editor
#   Project slug + XDG paths ───  _project_slug _project_config _project_state_dir
#   Project registry ───────────  _register_project _unregister_project
#   Project root detection ─────  _find_project_root
#   Migration (.connie/ → XDG) ─  _migrate_project
#   Config merging ─────────────  _merge_configs _validate_config_file
#   Override generation ────────  _build_fwd_env_obj _build_cli_env_obj
#                                  _build_env_block _build_vol_block
#                                  _build_ports_section _generate_override
#   Context generation ─────────  _generate_connie_context _emit_user_context
#                                  _emit_project_context _emit_local_context
#                                  _write_user_context
#   Context preview formatting ─  _ctx_preview_header _ctx_scope_header
#                                  _ctx_preview_footer
#   Validation / prepare ───────  _prepare
#   Compose ────────────────────  _compose_project_name _run_compose
#   Subcommands ────────────────  cmd_build_base cmd_init cmd_build cmd_run
#                                  cmd_clean cmd_remove cmd_list cmd_edit
#                                  cmd_config cmd_context cmd_doctor
#   Doctor helpers ─────────────  _doctor_section _doctor_pass _doctor_warn
#                                  _doctor_fail _doctor_check
#   Main ───────────────────────  _main
#
# ── End function index ───────────────────────────────────────────────────────
set -eu

# ── Version and paths ─────────────────────────────────────────────────────────

VERSION="0.5.0"
TOOL="connie"
# Production default for the base image tag. Overridable via
# $CONNIE_BASE_IMAGE so tests can build to an isolated tag without
# clobbering the user's real `connie/base:latest`. Also useful outside
# testing — e.g. building a `connie-arm/base:latest` on an arm host
# without overwriting the x86_64 image.
BASE_IMAGE="${CONNIE_BASE_IMAGE:-connie/base:latest}"

# CONNIE_LIB_DIR can be overridden for development:
#   CONNIE_LIB_DIR=./src ./src/connie run ~/repos/project
LIB_DIR="${CONNIE_LIB_DIR:-/usr/local/lib/connie}"
PROJECT_TEMPLATE="$LIB_DIR/config/project.yml"
USER_TEMPLATE="$LIB_DIR/config/user.yml"
DEFAULTS_FILE="$LIB_DIR/config/defaults.yml"

_xdg_config_dirs="${XDG_CONFIG_DIRS:-/etc/xdg}"
SYSTEM_CONFIG="${_xdg_config_dirs%%:*}/$TOOL/config.yml"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$TOOL"
USER_CONFIG="$CONFIG_DIR/config.yml"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/$TOOL"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$TOOL"
PROJECTS_FILE="$DATA_DIR/projects.yml"

# ── Utilities ─────────────────────────────────────────────────────────────────

# ── Verbosity ────────────────────────────────────────────────────────────────
#
# Three levels controlling what reaches stderr:
#   0  quiet   — only _die survives; _info, _detail, _debug silent
#   1  normal  — _die, _info, _detail visible (default)
#   2  verbose — also enables _debug (used to trace docker compose calls)
#
# Set via CLI flag (-q / -v) or env var (CONNIE_QUIET / CONNIE_VERBOSE),
# evaluated in `_main`. Env wins over the default; CLI wins over env.
# Always show errors — _die ignores _VERBOSITY entirely.
_VERBOSITY=1

_die() {
    printf 'error: %s\n' "$1" >&2
    # Optional second argument: an actionable hint printed under the
    # primary message, indented to align with the leading 'error: '.
    # Helps users recover without a search engine round-trip. Same
    # split-message convention as _doctor's check output.
    [ -n "${2:-}" ] && printf '       %s\n' "$2" >&2
    exit 1
}

_info() {
    [ "$_VERBOSITY" -ge 1 ] || return 0
    printf '==> %s\n' "$1" >&2
}

_detail() {
    [ "$_VERBOSITY" -ge 1 ] || return 0
    printf '    %s\n' "$1" >&2
}

# Debug output — only shown when -v / CONNIE_VERBOSE is active. Used
# for "what is connie actually about to run" tracing that would be
# noise during normal use but invaluable when diagnosing why a
# `connie run` is hanging or failing.
_debug() {
    [ "$_VERBOSITY" -ge 2 ] || return 0
    printf '[debug] %s\n' "$1" >&2
}

# Interactive y/N prompt. Returns 0 on yes, 1 on anything else
# (including empty / Ctrl-D / "no"). Prompt goes to stderr (so a
# pipeline capturing stdout doesn't see it); reads from stdin.
#
# In non-interactive contexts (stdin not a TTY), callers MUST set
# their own bypass flag (e.g. cmd_remove's --yes) before calling
# this; otherwise the prompt would silently hang waiting for input
# that will never come. The convention this matches is `rm -i`:
# interactive prompts only fire when there's a terminal to prompt to.
_confirm() {
    printf '%s [y/N] ' "$1" >&2
    read -r _cf_answer || _cf_answer=""
    case "$_cf_answer" in
        y | Y | yes | YES) return 0 ;;
        *) return 1 ;;
    esac
}

_require() {
    command -v "$1" >/dev/null 2>&1 ||
        _die "'$1' is required but not installed." \
            "Run '$TOOL doctor' for a full check of prerequisites."
}

# Portable temp-file creation. BSD/macOS mktemp requires a template (or -t),
# rejecting a bare `mktemp`; GNU and busybox accept the bare form but also
# honour a template. We always pass one so connie runs on a macOS host, not
# only on Linux. $TMPDIR is respected when set (macOS points it at a per-user
# directory), falling back to /tmp; its trailing slash is stripped so the
# resulting path has no '//'.
_mktemp() {
    _mt_base="${TMPDIR:-/tmp}"
    mktemp "${_mt_base%/}/connie.XXXXXX"
}

_require_yq() {
    _require yq
    # eval-all is a yq v4 (mikefarah) command; earlier versions and the Python
    # yq fork do not have it and will produce cryptic errors throughout.
    yq eval-all 'null' /dev/null >/dev/null 2>&1 ||
        _die "'yq' v4 (github.com/mikefarah/yq) is required, but the installed 'yq' does not support 'eval-all'." \
            "Install yq v4: https://github.com/mikefarah/yq#install"
}

_usage() {
    cat <<EOF
$TOOL v$VERSION

Runs Claude Code in a constrained, reproducible container attached to a
project directory. The container has read/write access only to the project
workspace and per-project Claude Code state. Nothing is written to the
project directory itself.

Usage:
  $TOOL init       [dir]    Initialize connie for a project directory
  $TOOL run        [dir]    Build (if needed) and start Claude Code
  $TOOL build      [dir]    Build the project container image without starting it
  $TOOL build-base          Build (or rebuild) the connie base image
  $TOOL clean      [dir]    Remove the locally built project container image
  $TOOL remove     [dir]    Remove ALL connie-owned state for a project (inverse of init)
  $TOOL list                List the project workspaces connie knows about
  $TOOL config     [dir]    Show project paths and effective Compose override
  $TOOL edit       [dir]    Edit a project's config file in your \$EDITOR
  $TOOL edit       --user   Edit your user-global config (created if absent)
  $TOOL context    [dir]    Generate and show the Claude Code context file
  $TOOL doctor     [dir]    Diagnose required tools, install, base image, project
  $TOOL help                Show this message
  $TOOL version             Show version

Options (run, build, config):
  --package <pkg>    Install an additional apk package (repeatable)
  --env KEY=VALUE    Set an additional environment variable (repeatable)
  --cmd <cmd>        Override the start command (default: claude)

Options (edit):
  --user             Edit the user-global config instead of a project's

Options (remove):
  --yes              Skip the y/N confirmation (required in non-TTY)
  --keep-state       Preserve the state dir (keeps OAuth + history)
  --keep-image       Skip Docker image + network removal
  --dry-run          Print what would be removed; touch nothing

Verbosity (any subcommand):
  -q, --quiet        Suppress info/detail output; only errors reach stderr
  -v, --verbose      Also emit [debug] lines (traces docker compose calls)

Config is read in this order (lowest to highest precedence):
  $LIB_DIR/config/defaults.yml
  $SYSTEM_CONFIG
  $USER_CONFIG
  $CONFIG_DIR/projects/<slug>/config.yml
  CONNIE_CMD, CONNIE_MEMORY, CONNIE_CPUS, CONNIE_MAX_PIDS
  CLI flags (--package, --env, --cmd)

Environment variables:
  CONNIE_LIB_DIR    Override the library path (default: /usr/local/lib/connie)
  CONNIE_QUIET=1    Same as --quiet
  CONNIE_VERBOSE=1  Same as --verbose
  CONNIE_CMD        Override the container start command
  CONNIE_MEMORY     Override the container memory limit (e.g. 8g)
  CONNIE_CPUS       Override the container CPU limit (e.g. 4.0)
  CONNIE_MAX_PIDS   Override the container PID limit

Standard mounts (always present, not configurable):
  [project dir]                    →  /workspace                      read/write
  $STATE_DIR/<slug>/.claude        →  /home/claude-user/.claude       read/write
  $STATE_DIR/<slug>/.claude.json   →  /home/claude-user/.claude.json  read/write

EOF
}

# ── Project slug and XDG paths ────────────────────────────────────────────────

# One-entry cache for _project_slug — a single invocation operates on one path.
_SLUG_CACHE_PATH=""
_SLUG_CACHE_VALUE=""

# Derive a stable, unique slug from a project root path: basename-hash.
# The trailing-newline from basename is stripped before joining with the hash.
_project_slug() {
    [ "$1" = "$_SLUG_CACHE_PATH" ] && [ -n "$_SLUG_CACHE_VALUE" ] && {
        printf '%s' "$_SLUG_CACHE_VALUE"
        return
    }
    _ps_base=$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')
    _ps_hash=$(printf '%s' "$1" | cksum | cut -d' ' -f1)
    _SLUG_CACHE_VALUE=$(printf '%s-%s' "$_ps_base" "$_ps_hash")
    _SLUG_CACHE_PATH="$1"
    printf '%s' "$_SLUG_CACHE_VALUE"
}

_project_config() {
    printf '%s/projects/%s/config.yml' "$CONFIG_DIR" "$(_project_slug "$1")"
}

_project_state_dir() {
    printf '%s/%s' "$STATE_DIR" "$(_project_slug "$1")"
}

# Ensure a project has an XDG config, dying with a context-aware hint if not.
# Commands that don't run _prepare (config/clean/context) call this so a
# legacy .connie/ project gets a "migrate" hint — those commands don't
# auto-migrate (only build/run do, via _prepare), and a bare "scaffold one"
# message would be misleading when state clearly already exists.
_require_project_config() {
    _rpc_root="$1"
    [ -f "$(_project_config "$_rpc_root")" ] && return 0
    if [ -d "$_rpc_root/.connie" ]; then
        _die "No XDG config for $_rpc_root, but a legacy .connie/ layout is present." \
            "Run '$TOOL run $_rpc_root' (or '$TOOL build') once to migrate it to XDG, then retry."
    fi
    _die "No project config found for $_rpc_root." \
        "Run '$TOOL init $_rpc_root' to scaffold one, or '$TOOL doctor $_rpc_root' to diagnose."
}

# ── Project registry ──────────────────────────────────────────────────────────

_register_project() {
    _rp_root="$1"
    _rp_slug="$2"
    mkdir -p "$DATA_DIR"
    [ -f "$PROJECTS_FILE" ] || printf '{}' >"$PROJECTS_FILE"
    ROOT="$_rp_root" SLUG="$_rp_slug" yq -i '.[env(ROOT)] = env(SLUG)' "$PROJECTS_FILE"
}

# Inverse of _register_project: removes the path→slug entry from the
# registry. No-op if the file or entry doesn't exist — safe to call
# during `connie remove` against a project that was never registered.
_unregister_project() {
    _up_root="$1"
    [ -f "$PROJECTS_FILE" ] || return 0
    ROOT="$_up_root" yq -i 'del(.[env(ROOT)])' "$PROJECTS_FILE"
}

# ── Project root detection ────────────────────────────────────────────────────

_find_project_root() {
    _dir="${1:-$PWD}"
    _dir=$(cd "$_dir" 2>/dev/null && pwd) || _die "Directory not found: ${1:-$PWD}"

    # Check registry: walk up looking for a registered project path
    if [ -f "$PROJECTS_FILE" ]; then
        _walk="$_dir"
        while [ "$_walk" != "/" ]; do
            _hit=$(ROOT="$_walk" yq '.[env(ROOT)] // ""' "$PROJECTS_FILE" 2>/dev/null || true)
            if [ -n "$_hit" ] && [ "$_hit" != "null" ]; then
                printf '%s' "$_walk"
                return 0
            fi
            _walk=$(dirname "$_walk")
        done
    fi

    # Fall back to old-style .connie/ directory (triggers auto-migration in _prepare)
    _walk="$_dir"
    while [ "$_walk" != "/" ]; do
        if [ -d "$_walk/.connie" ]; then
            printf '%s' "$_walk"
            return 0
        fi
        _walk=$(dirname "$_walk")
    done

    printf '%s' "$_dir"
}

# ── Migration from old .connie/ layout ───────────────────────────────────────

_migrate_project() {
    _mp_root="$1"
    _mp_slug=$(_project_slug "$_mp_root")
    _mp_cfg_dir="$CONFIG_DIR/projects/$_mp_slug"
    _mp_state_dir="$STATE_DIR/$_mp_slug"
    _mp_old="$_mp_root/.connie"

    _info "Migrating $TOOL state for $_mp_root to XDG directories"

    mkdir -p "$_mp_cfg_dir" "$_mp_state_dir"
    # The state hierarchy holds Claude Code OAuth credentials. Tighten the
    # directory permissions to 0700 (user only) as defense-in-depth so other
    # local users on the same machine cannot read the bearer token, even if
    # Claude Code itself does not set restrictive perms on .credentials.json.
    chmod 700 "$_mp_state_dir"

    if [ -f "$_mp_old/config.yml" ]; then
        mv "$_mp_old/config.yml" "$_mp_cfg_dir/config.yml"
        _detail "moved   config.yml   →  $CONFIG_DIR/projects/$_mp_slug/"
    elif [ ! -f "$_mp_cfg_dir/config.yml" ]; then
        cp "$PROJECT_TEMPLATE" "$_mp_cfg_dir/config.yml"
        _detail "created config.yml   →  $CONFIG_DIR/projects/$_mp_slug/"
    fi

    if [ -d "$_mp_old/.claude" ]; then
        mv "$_mp_old/.claude" "$_mp_state_dir/.claude"
        _detail "moved   .claude/     →  $STATE_DIR/$_mp_slug/"
    else
        mkdir -p "$_mp_state_dir/.claude"
    fi
    chmod 700 "$_mp_state_dir/.claude"

    if [ -f "$_mp_old/.claude.json" ]; then
        mv "$_mp_old/.claude.json" "$_mp_state_dir/.claude.json"
        _detail "moved   .claude.json →  $STATE_DIR/$_mp_slug/"
    else
        printf '{}' >"$_mp_state_dir/.claude.json"
    fi

    rm -f "$_mp_old/override.yml"
    if rmdir "$_mp_old" 2>/dev/null; then
        _detail "removed .connie/ from project directory"
    else
        _detail "note: .connie/ not empty — not removed (check for unexpected files)"
    fi

    _register_project "$_mp_root" "$_mp_slug"
    _info "Migration complete."
}

# ── Config merging ────────────────────────────────────────────────────────────
#
# Compose the layers (defaults → system → user → project) into one merged
# document. Composition is ADDITIVE and keyed: a more-specific layer adds to,
# overrides within, or refines what a more-general layer established, rather
# than wholesale-replacing it. See docs/config-merge.md for the full model.
#
#   maps (env, resources) /     deep-merge; the most-specific value wins per
#     scalars (start_cmd)        leaf.
#   build_commands              append in precedence order (an ordered list;
#                               duplicates are meaningful and kept).
#   keyed sets (packages,       accumulate across layers, then collapse to one
#     ports, unsafe_extra_mounts) entry per identity — package name, host port,
#                               container target — keeping the most-specific.
#                               This is how a lower layer remaps a port or
#                               redefines a mount. A leading-`-` entry
#                               (`-vim`, `"-8080"`, `-/data`) deletes that
#                               identity, as does a null env value.
#
# This only ever composes application settings; the container's security
# posture (cap-drop, no-new-privileges, read-only rootfs, SUID stripping,
# non-root user) is fixed in the image/compose base and is unreachable here.
_merge_configs() {
    _mc_root="$1"
    [ -f "$DEFAULTS_FILE" ] ||
        _die "defaults.yml not found at $DEFAULTS_FILE" \
            "Reinstall connie: make install PREFIX=~/.local (or 'connie doctor' to verify the install)"
    _mc_work=$(_mktemp)

    printf '{}' >"$_mc_work"

    # Accumulate every present layer. `*+` deep-merges maps, lets the
    # most-specific scalar win, and APPENDS arrays (the '+'); the keyed-set
    # collapse below turns those appended arrays into the right per-identity
    # result. A present-but-null layer (a fully-commented config) contributes
    # nothing, which is correct.
    for _mc_cfg in \
        "$DEFAULTS_FILE" \
        "$SYSTEM_CONFIG" \
        "$USER_CONFIG" \
        "$(_project_config "$_mc_root")"; do
        [ -f "$_mc_cfg" ] || continue
        _mc_tmp=$(_mktemp)
        # shellcheck disable=SC2016 # $item is a yq variable, not a shell var
        yq eval-all '. as $item ireduce ({}; . *+ $item)' \
            "$_mc_work" "$_mc_cfg" >"$_mc_tmp" ||
            {
                rm -f "$_mc_work" "$_mc_tmp"
                return 1
            }
        mv "$_mc_tmp" "$_mc_work"
    done

    # Resolve deletes, then collapse each keyed set to one entry per identity.
    # A null env value and a leading-`-` list entry (`-vim`, `"-8080"`,
    # `-/data`) are delete directives keyed by identity — package name, host
    # port, container target. Identity ignores the leading `-`, so
    # `reverse | unique_by(identity) | reverse` lets the most-specific add OR
    # delete per identity win (this is what allows delete-then-re-add across
    # layers); any surviving delete directive is then dropped. ports are coerced
    # to strings first so a `"-8080"` directive is not parsed as the integer
    # -8080. build_commands stays the appended, ordered list — it has no delete.
    yq -i '
        .env = (.env // {} | with_entries(select(.value != null)))
      | .packages = (.packages // []
          | reverse | unique_by(sub("^-"; "")) | reverse
          | map(select(test("^-") | not)))
      | .ports = (.ports // [] | map(tostring)
          | reverse | unique_by(sub("^-"; "") | split(":") | .[0]) | reverse
          | map(select(test("^-") | not)))
      | .unsafe_extra_mounts = (.unsafe_extra_mounts // []
          | reverse | unique_by(sub("^-"; "") | (split(":") | .[1]) // .) | reverse
          | map(select(test("^-") | not)))
    ' "$_mc_work" ||
        {
            rm -f "$_mc_work"
            return 1
        }

    cat "$_mc_work"
    rm -f "$_mc_work"
}

# ── Override file generation ──────────────────────────────────────────────────

# Build a JSON object of terminal-forwarding env vars (lowest-precedence env
# entries). FORCE_COLOR is included because Node.js/chalk probes the Docker PTY
# via process.stdout.getColorDepth() — that probe underestimates color support
# inside Docker even when TERM/COLORTERM are correct. FORCE_COLOR bypasses it.
# Docker's -t hardcodes TERM=xterm with no COLORTERM, so both must be forwarded.
_build_fwd_env_obj() {
    _bfe_term="${TERM:-xterm-256color}"
    case "${COLORTERM:-}" in
        truecolor | 24bit) _bfe_force_color=3 ;;
        *)
            case "$_bfe_term" in
                *256color* | *truecolor*) _bfe_force_color=2 ;;
                *) _bfe_force_color=1 ;;
            esac
            ;;
    esac
    if [ -n "${COLORTERM:-}" ]; then
        FT="$_bfe_term" FC="$COLORTERM" FF="$_bfe_force_color" \
            yq -n -o=json '{"FORCE_COLOR": strenv(FF), "TERM": strenv(FT), "COLORTERM": strenv(FC)}'
    else
        FT="$_bfe_term" FF="$_bfe_force_color" \
            yq -n -o=json '{"FORCE_COLOR": strenv(FF), "TERM": strenv(FT)}'
    fi
}

# Fold newline-delimited KEY=VALUE pairs (from --env flags) into a JSON object.
# Values are encoded via yq so special characters are escaped safely.
_build_cli_env_obj() {
    _bce_obj="{}"
    [ -n "$1" ] || {
        printf '%s' "$_bce_obj"
        return
    }
    _oldifs=$IFS
    # $1 is newline-delimited — see --env accumulation in argument parsing.
    IFS='
'
    for _pair in $1; do
        [ -n "$_pair" ] || continue
        case "$_pair" in
            *=*)
                _k=${_pair%%=*}
                _v=${_pair#*=}
                ;;
            *)
                _k=$_pair
                _v=""
                ;;
        esac
        _bce_obj=$(BASE="$_bce_obj" K="$_k" V="$_v" \
            yq -n -o=json 'env(BASE) * {strenv(K): strenv(V)}')
    done
    IFS=$_oldifs
    printf '%s' "$_bce_obj"
}

# Build the YAML environment block by merging three sources in ascending
# precedence: terminal forwarding (low) < config .env < --env flags (high).
# Outputs indented YAML key-value lines, or '{}' if the merged map is empty.
_build_env_block() {
    # $1 = extra_env (newline-delimited KEY=VALUE from --env flags)
    # $2 = merged_file
    _bee_fwd=$(_build_fwd_env_obj)
    _bee_cli=$(_build_cli_env_obj "$1")
    # Env var NAMES must be safe identifiers. Validate the config .env keys
    # AND the raw --env keys against an ASCII allowlist in the shell
    # (LC_ALL=C grep), not via a yq Unicode regex: yq's handling of exotic
    # code points — and the non-POSIX printf needed to produce them in tests
    # — varied across builds, whereas a name outside the allowlist is
    # rejected the same way regardless of how it is represented. A bad name
    # can carry a newline/quote/colon that would corrupt the override (an env
    # key with a newline could even inject a sibling Compose key), so reject
    # it up front. CLI keys are read from the raw $1 input because a control
    # byte there would already have been dropped by the yq fold in
    # _build_cli_env_obj.
    _bee_keys=$(
        yq '.env // {} | keys | .[]' "$2" 2>/dev/null || true
        printf '%s\n' "$1" | sed 's/=.*//'
    )
    if printf '%s\n' "$_bee_keys" | grep -v '^$' |
        LC_ALL=C grep -qvE '^[A-Za-z0-9_][A-Za-z0-9_.-]*$'; then
        _die "Invalid environment variable name." \
            "Env keys (config .env or via --env) must match [A-Za-z0-9_][A-Za-z0-9_.-]* — letters, digits, underscore, dot, or dash."
    fi
    # Reject an empty config .env key (the allowlist above can't see it: a
    # lone empty key collapses to an empty string after command substitution).
    if [ "$(yq '[.env // {} | keys | .[] | select(. == "")] | length' "$2" 2>/dev/null || printf 0)" != "0" ]; then
        _die "Empty environment variable name in config .env." \
            "Give every .env entry a non-empty name."
    fi
    # Reject an empty --env name (a "=value" flag), which the allowlist
    # likewise drops as a blank line.
    if [ -n "$1" ] && printf '%s\n' "$1" | grep -q '^='; then
        _die "Empty environment variable name via --env." \
            "Use --env NAME=VALUE with a non-empty name."
    fi
    # Reject non-scalar env VALUES (a map/sequence value is not a valid
    # Compose environment value and would otherwise be emitted as inline JSON
    # that docker compose rejects at run time).
    if [ "$(yq '[.env // {} | .[] | select((tag == "!!map") or (tag == "!!seq"))] | length' "$2" 2>/dev/null || printf 0)" != "0" ]; then
        _die "Non-scalar value in config .env." \
            "Env values must be scalars (string/number/bool), not maps or lists."
    fi
    # JSON-encode BOTH key and value. Encoding only the value left the key
    # raw: a config .env key containing a newline could inject a sibling
    # compose key (e.g. `privileged: true`) onto the workspace service — a
    # full host escape. @json on the key emits a single quoted scalar.
    _bee_block=$(FWD="$_bee_fwd" CLI="$_bee_cli" yq '
        (env(FWD) * .env * env(CLI)) |
        to_entries |
        .[] |
        "      " + (.key | @json) + ": " + (.value | @json)
    ' "$2")
    # Empty map kept out of the heredoc — literal braces collide with ${...}.
    [ -n "$_bee_block" ] || _bee_block="      {}"
    printf '%s' "$_bee_block"
}

# Build the YAML volumes block: standard mounts first, then any opt-in
# unsafe_extra_mounts from config.
# Lexically normalize an ABSOLUTE path (collapse //, resolve . and ..) with
# no filesystem access, so path-equivalent spellings of the socket directory
# (/var//run, /var/run/., /var/run/../run, //var/run) all compare equal to
# the canonical form in the socket guard below. Relative inputs (not host
# bind sources that can reach the socket dir) are returned unchanged.
_normalize_abs_path() {
    case "$1" in
        /*) : ;;
        *)
            printf '%s' "$1"
            return
            ;;
    esac
    _nap_out=""
    _nap_oldifs=$IFS
    IFS=/
    for _nap_seg in $1; do
        case "$_nap_seg" in
            '' | .) continue ;;
            ..) _nap_out=${_nap_out%/*} ;;
            *) _nap_out="$_nap_out/$_nap_seg" ;;
        esac
    done
    IFS=$_nap_oldifs
    printf '%s' "${_nap_out:-/}"
}

# Reject an `unsafe_extra_mounts:` entry that would defeat the container
# hardening. Extra mounts are trusted developer opt-in, but connie guards
# the catastrophic mistakes — the same intent as the original docker.sock check,
# widened to the whole class. Both the host source and the container target
# are normalized first so equivalent spellings (//, ., ..) cannot evade the
# comparison. Rejects: the daemon socket (by source name, by the source
# being a unix socket, or by the target re-exposing it), the daemon data
# root, the kernel/device trees, host root, mounts that shadow connie's own
# standard mounts, and unsafe mount propagation.
_reject_unsafe_mount() {
    _rum_entry="$1"
    # Source = first ':'-field; target = second; opts = the rest. Trim
    # surrounding whitespace before normalizing (Docker reads it literally,
    # but keep the guard's view aligned with the real path).
    _rum_src=${_rum_entry%%:*}
    _rum_src=${_rum_src#"${_rum_src%%[![:space:]]*}"}
    _rum_src=${_rum_src%"${_rum_src##*[![:space:]]}"}
    _rum_src=$(_normalize_abs_path "$_rum_src")
    _rum_rest=${_rum_entry#*:}
    _rum_tgt=${_rum_rest%%:*}
    _rum_tgt=${_rum_tgt#"${_rum_tgt%%[![:space:]]*}"}
    _rum_tgt=${_rum_tgt%"${_rum_tgt##*[![:space:]]}"}
    _rum_tgt=$(_normalize_abs_path "$_rum_tgt")
    # Options are the third ':'-field. Docker separates multiple options with
    # commas (e.g. rw,rshared); strip whitespace and normalize commas to
    # colons before the propagation check below, so neither a comma-joined nor
    # a whitespace-padded option (e.g. "rw, rshared") can evade it.
    _rum_opts=""
    case "$_rum_rest" in *:*) _rum_opts=$(printf '%s' "${_rum_rest#*:}" | tr -d '[:space:]' | tr ',' ':') ;; esac

    # 1. Sensitive host SOURCE: daemon socket/data, kernel/device trees, root.
    case "$_rum_src" in
        / | /var | /var/lib | /var/lib/docker | /var/lib/docker/* | \
            /var/lib/containerd | /var/lib/containerd/* | \
            /var/run | /var/run/* | /run | /run/* | \
            /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | /boot | /boot/* | \
            docker.sock | */docker.sock)
            _die "Refusing to mount a sensitive host path: $_rum_entry" \
                "Mounting the docker socket/data, the kernel or device trees (/proc, /sys, /dev), or host root grants host control and defeats connie's hardening. Remove this entry from the unsafe_extra_mounts: list."
            ;;
    esac
    # 2. Host SOURCE that is itself a unix socket (any name) — likely a
    #    Docker/podman daemon API socket reachable from the container.
    if [ -S "$_rum_src" ] || [ -S "$_rum_src/docker.sock" ]; then
        _die "Refusing to mount a unix socket (possible daemon API): $_rum_entry" \
            "A unix-socket bind mount can reach a host daemon and defeat connie's hardening. Remove this entry from the unsafe_extra_mounts: list."
    fi
    # 3. Container TARGET that re-exposes the daemon socket — catches a
    #    renamed host socket mapped onto the conventional in-container path.
    case "$_rum_tgt" in
        /var/run/docker.sock | /run/docker.sock | /var/run | /run)
            _die "Refusing a mount whose container target re-exposes the Docker socket: $_rum_entry" \
                "Mapping any source onto $_rum_tgt reaches the daemon. Remove this entry from the unsafe_extra_mounts: list."
            ;;
    esac
    # 4. Container TARGET that shadows a connie-managed standard mount.
    case "$_rum_tgt" in
        / | /home | /home/claude-user | /workspace | \
            /home/claude-user/.claude | /home/claude-user/.claude.json)
            _die "Refusing a mount that shadows a standard connie mount: $_rum_entry" \
                "Target $_rum_tgt would override connie's /workspace or ~/.claude mounts. Use a different container path."
            ;;
    esac
    # 5. Unsafe mount propagation (host mount-namespace manipulation).
    case ":$_rum_opts:" in
        *:rshared:* | *:shared:* | *:rslave:* | *:slave:*)
            _die "Refusing a mount with unsafe propagation: $_rum_entry" \
                "Only ro/rw/z/Z are supported; shared/rshared/slave/rslave can manipulate the host mount namespace."
            ;;
    esac
}

_build_vol_block() {
    # $1 = project_root, $2 = merged_file
    _bvb_state=$(_project_state_dir "$1")
    # Standard mounts (connie-controlled), one raw "host:container[:opts]"
    # string per line. Config-supplied extras are appended after validation.
    _bvb_mounts="${1}:/workspace:rw
${_bvb_state}/.claude:/home/claude-user/.claude
${_bvb_state}/.claude.json:/home/claude-user/.claude.json"
    # Extra mounts are an explicit, advanced opt-in under the
    # `unsafe_extra_mounts:` config key (not the default `volumes:` — extra
    # host mounts are the one config lever that can hand the container a host
    # resource, so they require a deliberately-named key). The old `volumes:`
    # key was removed; fail loudly if a stale config still uses it rather
    # than silently dropping a mount the user still expects.
    if [ "$(yq '.volumes != null' "$2" 2>/dev/null || printf false)" = "true" ]; then
        _die "The 'volumes:' config key has been removed." \
            "Extra host mounts are now an explicit opt-in: rename it to 'unsafe_extra_mounts:'. See the README and SECURITY.md — these are trusted, lightly-guarded mounts, so only add what you must."
    fi

    # Reject long-syntax (mapping) entries up front. connie supports only
    # short-syntax "host:container[:opts]" strings; yq '… | .[]' would
    # otherwise flatten a {type,source,target} mapping into separate lines
    # that get re-emitted as bogus mounts AND slip past the socket guard
    # below (the host segment of such a line parses as "source").
    _bvb_badcount=$(yq '[.unsafe_extra_mounts // [] | .[] | select(tag != "!!str")] | length' "$2" 2>/dev/null || printf 0)
    [ "${_bvb_badcount:-0}" = "0" ] ||
        _die "Unsupported entry in unsafe_extra_mounts." \
            "connie supports only short-syntax string mounts ('host:container[:opts]'). Rewrite any long-syntax (type:/source:/target:) entries."

    _bvb_extra=$(yq '.unsafe_extra_mounts | .[]' "$2" 2>/dev/null || true)
    if [ -n "$_bvb_extra" ]; then
        # Validate every config-supplied mount against the dangerous-mount
        # guard (see _reject_unsafe_mount) before appending it.
        _oldifs=$IFS
        IFS='
'
        for _bvb_entry in $_bvb_extra; do
            [ -n "$_bvb_entry" ] || continue
            _reject_unsafe_mount "$_bvb_entry"
        done
        IFS=$_oldifs
        _bvb_mounts="${_bvb_mounts}
${_bvb_extra}"
    fi
    # Emit a YAML block sequence via yq so every mount string — including
    # config-supplied paths — is quoted exactly when YAML requires it and
    # can never break out of the override. yq emits at column 0; indent to
    # the 6-space depth the override's `volumes:` key expects.
    VOLS="$_bvb_mounts" yq -n -o=yaml \
        'strenv(VOLS) | split("\n") | map(select(. != ""))' |
        sed 's/^/      /'
}

# Build the YAML ports section. Outputs nothing if no ports are configured.
_build_ports_section() {
    # $1 = merged_file
    _bps_ports=$(yq '.ports | .[]' "$1" 2>/dev/null || true)
    [ -n "$_bps_ports" ] || return 0
    # Force double-quoted scalars via @json. Ports are conventionally quoted
    # in Compose (an unquoted HH:MM-style value trips YAML's sexagesimal
    # parsing), and @json escapes any value into a safe YAML string.
    _bps_block=$(PORTS="$_bps_ports" yq -n \
        'strenv(PORTS) | split("\n") | .[] | select(. != "") | "      - " + (. | @json)')
    printf '    ports:\n%s' "$_bps_block"
}

_generate_override() {
    _project_root="$1"
    _merged_file="$2"
    _extra_packages="$3"
    _extra_env="$4"
    _override_cmd="$5"

    # Reject wrong-typed config keys up front so a type mistake fails with a
    # clear connie error instead of a silent drop or a raw yq error emitted
    # mid-pipeline. Each major key must be its expected YAML type (or absent).
    for _got in 'env !!map' 'packages !!seq' 'build_commands !!seq' \
        'ports !!seq' 'unsafe_extra_mounts !!seq'; do
        _gt_key=${_got% *}
        _gt_want=${_got#* }
        _gt_tag=$(yq ".${_gt_key} | tag" "$_merged_file" 2>/dev/null || printf '!!null')
        case "$_gt_tag" in
            '!!null' | "$_gt_want") : ;;
            *)
                _die "Invalid type for '${_gt_key}:' in config (got ${_gt_tag#!!}, expected ${_gt_want#!!})." \
                    "Fix the config so '${_gt_key}:' is a ${_gt_want#!!}."
                ;;
        esac
    done

    # Extract values from merged config.
    # No // fallbacks needed — defaults.yml guarantees all keys are present.
    _packages=$(yq '.packages | join(" ")' "$_merged_file")
    _build_cmds=$(yq '.build_commands | join(" && ")' "$_merged_file")
    _start_cmd=$(yq '.start_cmd' "$_merged_file")
    _memory=$(yq '.resources.memory' "$_merged_file")
    _cpus=$(yq '.resources.cpus' "$_merged_file")
    _max_pids=$(yq '.resources.max_pids' "$_merged_file")

    # Apply CONNIE_* env var overrides (above project config, below CLI flags)
    _start_cmd="${CONNIE_CMD:-$_start_cmd}"
    _memory="${CONNIE_MEMORY:-$_memory}"
    _cpus="${CONNIE_CPUS:-$_cpus}"
    _max_pids="${CONNIE_MAX_PIDS:-$_max_pids}"

    # Resource values flow into the override as bare YAML scalars (compose
    # wants mem_limit as a byte string, cpus as a number, pids_limit as an
    # int — quoting them would change their type). So instead of encoding,
    # validate them with a character-class allowlist. Rejecting any char
    # outside the set inherently rejects a newline/colon/space that could
    # inject a sibling compose key — closing the same YAML-injection class
    # the JSON-encoded scalars below handle. (A `case` glob, not grep, so the
    # whole value is matched, not line-by-line.)
    # Patterns reject bad chars (incl. newline/colon/space → no injection)
    # AND structurally-degenerate values that pass the charset but emit
    # invalid YAML/compose (e.g. 'g', '.', '-'): require a leading digit, a
    # single trailing unit (memory) / single dot (cpus) / leading-only sign
    # (pids).
    case "$_memory" in
        '' | *[!0-9bkmgBKMG]* | [!0-9]* | *[bkmgBKMG]?*)
            _die "Invalid resources.memory / CONNIE_MEMORY: '$_memory'" \
                "Expected a byte size like 4g, 512m, or a plain integer."
            ;;
    esac
    case "$_cpus" in
        '' | *[!0-9.]* | [!0-9]* | *.*.* | *.)
            _die "Invalid resources.cpus / CONNIE_CPUS: '$_cpus'" \
                "Expected a number like 2 or 2.0."
            ;;
    esac
    case "$_max_pids" in
        -1) : ;; # the only valid negative: Docker's "unlimited" sentinel
        '' | 0 | *[!0-9]*)
            _die "Invalid resources.max_pids / CONNIE_MAX_PIDS: '$_max_pids'" \
                "Expected a positive integer, or -1 for unlimited."
            ;;
    esac

    # Apply CLI overrides
    _final_packages="${_packages}${_extra_packages:+ $_extra_packages}"
    _final_cmd="${_override_cmd:-$_start_cmd}"

    # Package tokens are passed unquoted to `apk add` during the build, so a
    # token starting with '-' would be parsed as an apk flag (e.g.
    # --allow-untrusted). Reject them here; extend.Dockerfile also passes
    # `--` as a backstop. Intentional word-split on the space-joined list.
    # shellcheck disable=SC2086
    for _pkg in $_final_packages; do
        case "$_pkg" in
            -*)
                _die "Invalid package name: '$_pkg'" \
                    "Package names cannot start with '-' (it would be read as an apk flag). Check packages: / --package."
                ;;
        esac
    done

    # Encode every user-controlled scalar as a JSON string (always a valid,
    # fully-escaped YAML scalar) before splicing it into the override below.
    # `-o=json` is the same treatment CONNIE_CONTEXT already gets, and is
    # safer than bare `strenv`: yq's default plain output for a value like
    # `a: b` or `x #y` would corrupt the surrounding mapping or be read as a
    # comment when interpolated after `key:`.
    _build_cmds_yaml=$(CMD="$_build_cmds" yq -n -o=json 'strenv(CMD)')
    _final_packages_yaml=$(PKGS="$_final_packages" yq -n -o=json 'strenv(PKGS)')
    _final_cmd_yaml=$(FCMD="$_final_cmd" yq -n -o=json 'strenv(FCMD)')
    # BASE_IMAGE comes from $CONNIE_BASE_IMAGE (env, used by tests); encode it
    # too so the build-arg slot can't be broken by an unusual tag value.
    _base_image_yaml=$(IMG="$BASE_IMAGE" yq -n -o=json 'strenv(IMG)')

    # Generate the connie context and encode as a JSON string so the multi-line
    # value fits a single-line YAML build-arg slot. YAML parses double-quoted
    # strings with escape sequences (\n etc.), so docker compose passes the
    # original multi-line markdown to docker build. extend.Dockerfile writes it
    # to /etc/claude-code/CLAUDE.md inside the image.
    _connie_ctx=$(_generate_connie_context "$_project_root" "$_merged_file")
    _connie_ctx_yaml=$(CTX="$_connie_ctx" yq -n -o=json 'strenv(CTX)')

    # These builders validate their inputs and _die on a rejected value
    # (docker.sock mount, control-char env key, …). Because they run in a
    # command substitution, that _die exits only the sub-shell — so
    # propagate the failure with `|| exit` or _generate_override would carry
    # on and emit an override missing the rejected block.
    _env_block=$(_build_env_block "$_extra_env" "$_merged_file") || exit $?
    _vol_block=$(_build_vol_block "$_project_root" "$_merged_file") || exit $?
    _ports_section=$(_build_ports_section "$_merged_file") || exit $?

    # Emit the override, then escape every '$' as '$$'. docker compose
    # interpolates ${VAR}/$VAR in the compose file from connie's OWN
    # environment at build/run time — which would let a config value like
    # `${X}` evade the mount guard (guard sees `${X}`, compose expands it)
    # or leak a host env var into the container. connie never wants compose
    # interpolation (it generates literal values), so doubling all '$'
    # makes every value literal. The escape is transparent: compose turns
    # `$$` back into a single `$`, and build_commands still see their
    # original `$` when extend.Dockerfile runs them via `sh -c`.
    cat <<YAML | sed 's/\$/$$/g'
# Generated by connie — do not edit.
# Run 'connie config' to see your project config path and current settings.

services:
  workspace:
    build:
      args:
        BASE_IMAGE: ${_base_image_yaml}
        EXTRA_PACKAGES: ${_final_packages_yaml}
        BUILD_COMMANDS: ${_build_cmds_yaml}
        CONNIE_CONTEXT: ${_connie_ctx_yaml}
    environment:
${_env_block}
    volumes:
${_vol_block}
${_ports_section}
    mem_limit: ${_memory}
    memswap_limit: ${_memory}
    cpus: ${_cpus}
    pids_limit: ${_max_pids}
    ulimits:
      nofile:
        soft: 4096
        hard: 8192
    working_dir: /workspace
    command: ${_final_cmd_yaml}
YAML
}

# ── Context generation ───────────────────────────────────────────────────────
#
# Claude Code loads CLAUDE.md from four scopes:
#
#   1. Managed policy  /etc/claude-code/CLAUDE.md          ← connie generates
#   2. User-level      ~/.claude/CLAUDE.md                 ← connie generates
#   3. Project         /workspace/[.claude/]CLAUDE.md      ← connie never touches
#   4. Local           /workspace/CLAUDE.local.md          ← connie never touches
#
# connie populates scopes 1 and 2. The project and local scopes come from
# /workspace exactly as Claude Code finds them — a project that already has
# a CLAUDE.md works unchanged.

# Emit markdown describing the connie container environment. Read by
# _generate_override and embedded as the CONNIE_CONTEXT build arg;
# extend.Dockerfile writes it to /etc/claude-code/CLAUDE.md so Claude Code
# loads it as managed-policy context — the highest-priority, immutable scope.
_generate_connie_context() {
    _gcc_root="$1"
    _gcc_merged="$2"

    _gcc_memory=$(yq '.resources.memory' "$_gcc_merged")
    _gcc_cpus=$(yq '.resources.cpus' "$_gcc_merged")
    _gcc_max_pids=$(yq '.resources.max_pids' "$_gcc_merged")
    _gcc_pkgs=$(yq '.packages | .[]' "$_gcc_merged" 2>/dev/null || true)
    _gcc_cmds=$(yq '.build_commands | .[]' "$_gcc_merged" 2>/dev/null || true)
    _gcc_vols=$(yq '.unsafe_extra_mounts | .[]' "$_gcc_merged" 2>/dev/null || true)
    _gcc_ports=$(yq '.ports | .[]' "$_gcc_merged" 2>/dev/null || true)
    _gcc_env=$(yq '.env | to_entries | .[] | .key + ": " + (.value | tostring)' \
        "$_gcc_merged" 2>/dev/null || true)

    cat <<HEADER
# Connie Container Environment

You are running inside a connie container. Connie is a CLI that runs Claude
Code in a hardened, reproducible Docker environment scoped to a single
project directory. This file describes the container you are in; the
project itself is described by /workspace/CLAUDE.md (if present).

## Filesystem

- \`/workspace\` — the project directory, bind-mounted from the host (read/write)
- \`/tmp\` — ephemeral RAM-backed scratch space (lost on container exit)
- All other paths are read-only at runtime; no process can modify image layers

## Available Tools

HEADER
    # Wrap the "Base image:" sentence across two source lines so each
    # stays under 80 chars (markdownlint MD013). Markdown collapses a
    # single newline inside a paragraph, so the rendered output is
    # identical to the one-line form.
    printf 'Base image: bash, git, curl, wget, ripgrep, fd, jq, tree, file, tar,\n'
    printf 'gzip, unzip, lsof, and standard Unix utilities.\n'
    if [ -n "$_gcc_pkgs" ]; then
        _gcc_pkg_line=$(printf '%s\n' "$_gcc_pkgs" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
        printf '\nProject packages (apk): %s\n' "$_gcc_pkg_line"
    fi
    if [ -n "$_gcc_cmds" ]; then
        # Blank line before the list and zero indent on the bullets so
        # the output passes markdownlint MD007/MD032. Renders the same
        # as the prior 2-space-indented form in any markdown engine.
        printf '\nBuild-time setup commands:\n\n'
        printf '%s\n' "$_gcc_cmds" | sed 's/^/- /'
    fi
    if [ -n "$_gcc_vols" ]; then
        printf '\n## Additional Mounts\n\n'
        printf '%s\n' "$_gcc_vols" | sed 's/^/- /'
    fi
    if [ -n "$_gcc_ports" ]; then
        printf '\n## Exposed Ports\n\n'
        printf '%s\n' "$_gcc_ports" | sed 's/^/- /'
    fi
    if [ -n "$_gcc_env" ]; then
        printf '\n## Environment Variables\n\n'
        printf '%s\n' "$_gcc_env"
    fi
    cat <<FOOTER

## Resource Limits

Memory: ${_gcc_memory}  |  CPUs: ${_gcc_cpus}  |  Max PIDs: ${_gcc_max_pids}

## Security Constraints

The container runs as a non-root user (claude-user, uid 1000). All Linux
capabilities are dropped, no-new-privileges is set, the root filesystem is
read-only, and SUID/SGID bits have been stripped at build time. Network
access is available but no ports are exposed to the host unless listed
under Exposed Ports.
FOOTER
}

# Emit the user-level Claude Code context to stdout. Concatenates the host's
# /etc/claude-code/CLAUDE.md (system-wide) and ~/.claude/CLAUDE.md
# (user-specific), in that order, with block-level HTML comments identifying
# each contribution's source. Per the Claude Code docs, block-level HTML
# comments are stripped before context injection, so the markers cost no
# tokens but remain visible when humans preview the assembled file (e.g.
# via 'connie context'), making it easy to trace any instruction back to
# its host source. Emits nothing if neither host file exists.
#
# The system-wide path is overridable via $CONNIE_ETC_CLAUDE_MD so the
# test suite can stage fixtures without touching /etc/ (the path is
# unwritable to non-root and would otherwise be a global side-effect
# across all connie installations on the machine). In production the
# override is unset and the path defaults to the Claude Code docs'
# managed-policy location.
_emit_user_context() {
    _euc_etc="${CONNIE_ETC_CLAUDE_MD:-/etc/claude-code/CLAUDE.md}"
    _euc_user="$HOME/.claude/CLAUDE.md"

    if [ -f "$_euc_etc" ]; then
        printf '<!-- source: /etc/claude-code/CLAUDE.md on host (system-wide) -->\n\n'
        cat "$_euc_etc"
    fi
    if [ -f "$_euc_user" ]; then
        [ -f "$_euc_etc" ] && printf '\n'
        printf '<!-- source: ~/.claude/CLAUDE.md on host (user) -->\n\n'
        cat "$_euc_user"
    fi
}

# Emit the project-scope Claude Code context to stdout. Per the Claude Code
# memory docs, Claude Code looks for project context at either ./CLAUDE.md
# or ./.claude/CLAUDE.md from its working directory — /workspace inside the
# container. Both can coexist; if both are present, the docs say they load
# into context. This function reads from the host project root (which the
# container bind-mounts at /workspace) so 'connie context' can preview them
# without launching the container. Connie never writes these files.
_emit_project_context() {
    _epc_root="$1"
    _epc_main="$_epc_root/CLAUDE.md"
    _epc_alt="$_epc_root/.claude/CLAUDE.md"

    if [ -f "$_epc_main" ]; then
        printf '<!-- source: /workspace/CLAUDE.md -->\n\n'
        cat "$_epc_main"
    fi
    if [ -f "$_epc_alt" ]; then
        [ -f "$_epc_main" ] && printf '\n'
        printf '<!-- source: /workspace/.claude/CLAUDE.md -->\n\n'
        cat "$_epc_alt"
    fi
}

# Emit the local-scope Claude Code context (./CLAUDE.local.md) to stdout.
# The local scope is intended for personal, gitignored project notes per
# the Claude Code docs. As with the project scope, connie never writes this
# file; we read it from the host project root for preview only.
#
# Uses an `if` rather than `[ -f ] && cat` so the function returns 0 when
# the file is absent. With `set -eu` enabled at script scope, a non-zero
# return from this function inside `_local_ctx=$(_emit_local_context ...)`
# would abort the script before the empty-scope marker could be printed.
_emit_local_context() {
    _elc_root="$1"
    _elc_file="$_elc_root/CLAUDE.local.md"
    if [ -f "$_elc_file" ]; then
        cat "$_elc_file"
    fi
}

# Install the user-level Claude Code context to the per-project state
# directory. The state directory's .claude/ is bind-mounted to ~/.claude/
# inside the container, so the file lands at the user-level scope path
# Claude Code expects. Removes the destination instead of leaving a 0-byte
# file when both host sources are absent.
_write_user_context() {
    _wuc_root="$1"
    _wuc_dest="$(_project_state_dir "$_wuc_root")/.claude/CLAUDE.md"
    rm -f "$_wuc_dest"
    _emit_user_context >"$_wuc_dest"
    [ -s "$_wuc_dest" ] || rm -f "$_wuc_dest"
}

# ── Context preview formatting (used by cmd_context) ─────────────────────────
#
# Scope structure markers go to stdout as block-level HTML comments. Claude
# Code strips block-level HTML comments before context injection per its
# memory docs, so if the preview is ever redirected to a file and loaded
# back as actual context, the markers cost no tokens. Putting structure on
# stdout (rather than stderr) means `connie context > preview.md` produces
# a coherent, self-contained document with every scope clearly delineated.

_ctx_preview_header() {
    _cph_root="$1"
    cat <<COMMENT
<!--
═══════════════════════════════════════════════════════════════════════
Claude Code context preview
Project root: $_cph_root
═══════════════════════════════════════════════════════════════════════
Section markers below are block-level HTML comments. Claude Code strips
them on context injection per its memory documentation, so they cost no
tokens if this output is ever fed back in as actual context.
-->
COMMENT
}

_ctx_scope_header() {
    _csh_num="$1"
    _csh_title="$2"
    _csh_path="$3"
    _csh_origin="$4"
    cat <<COMMENT

<!--
═══════════════════════════════════════════════════════════════════════
Scope $_csh_num/4: $_csh_title
Path in container: $_csh_path
$_csh_origin
═══════════════════════════════════════════════════════════════════════
-->

COMMENT
}

_ctx_preview_footer() {
    cat <<COMMENT

<!--
═══════════════════════════════════════════════════════════════════════
End of context preview
═══════════════════════════════════════════════════════════════════════
-->
COMMENT
}

# ── Validation and config merge ───────────────────────────────────────────────

# Validate the project, auto-migrate if needed, write merged config to _out.
# The caller creates the output temp file, owns it, and is responsible for
# cleanup — _prepare never creates temp files of its own.
_prepare() {
    _prep_root="$1"
    _prep_out="$2"

    _require_yq

    # Auto-migrate from old .connie/ layout if the new config doesn't exist yet
    if [ ! -f "$(_project_config "$_prep_root")" ] && [ -d "$_prep_root/.connie" ]; then
        _migrate_project "$_prep_root"
    fi

    _prep_config=$(_project_config "$_prep_root")
    [ -f "$_prep_config" ] ||
        _die "No project config found for $_prep_root." \
            "Run '$TOOL init $_prep_root' to scaffold one, or '$TOOL doctor $_prep_root' to diagnose."

    _require docker

    if ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        _info "Base image '$BASE_IMAGE' not found — building it now."
        cmd_build_base
    fi

    # Pre-create the per-project Claude Code state on the host.
    #
    # .claude/ MUST exist as a directory before Docker mounts it. With
    # read_only: true the container filesystem is immutable, so Claude Code
    # cannot create this directory itself at runtime. The volume mount makes
    # it writable, but only once Docker has something to attach to.
    #
    # .claude.json MUST exist as a file. If absent Docker creates it as a
    # directory, which breaks Claude Code's JSON config parsing.
    _prep_state=$(_project_state_dir "$_prep_root")
    mkdir -p "$_prep_state/.claude"
    # See _migrate_project for rationale: 0700 protects the OAuth credential
    # file that Claude Code writes inside .claude/ from other local users.
    chmod 700 "$_prep_state" "$_prep_state/.claude"
    if [ ! -f "$_prep_state/.claude.json" ] || [ ! -s "$_prep_state/.claude.json" ]; then
        printf '{}' >"$_prep_state/.claude.json"
    fi

    _merge_configs "$_prep_root" >"$_prep_out"
}

# ── Compose project name ─────────────────────────────────────────────────────

# Derive a stable, unique Compose project name from the project root path.
# Using only 'name: connie' in docker-compose.yml would cause all projects to
# share the same Compose namespace, making images and containers collide.
_compose_project_name() {
    printf 'connie-%s' "$(_project_slug "$1")"
}

# ── Core: build and run via Compose ──────────────────────────────────────────

_run_compose() {
    _project_root="$1"
    _override_file="$2"
    shift 2

    _debug "docker compose -p $(_compose_project_name "$_project_root") -f $LIB_DIR/docker/docker-compose.yml -f $_override_file $*"
    docker compose \
        -p "$(_compose_project_name "$_project_root")" \
        -f "$LIB_DIR/docker/docker-compose.yml" \
        -f "$_override_file" \
        "$@"
}

# ── Subcommands ───────────────────────────────────────────────────────────────

cmd_build_base() {
    _require docker

    _base_dockerfile="$LIB_DIR/docker/base.Dockerfile"
    [ -f "$_base_dockerfile" ] ||
        _die "base.Dockerfile not found at $_base_dockerfile." \
            "Reinstall connie: make install PREFIX=~/.local"

    _info "Building connie base image ($BASE_IMAGE)..."
    _detail "Alpine 3.20 + bash + curl + git + coreutils + Claude Code (includes Node.js)"
    _detail "This may take a few minutes on first run."

    docker build \
        -f "$_base_dockerfile" \
        -t "$BASE_IMAGE" \
        "$(dirname "$_base_dockerfile")"

    _info "Base image built: $BASE_IMAGE"
}

cmd_init() {
    _target="${1:-$PWD}"
    _target=$(cd "$_target" 2>/dev/null && pwd) || _die "Directory not found: $_target"

    _require_yq

    _init_slug=$(_project_slug "$_target")
    _init_cfg_dir="$CONFIG_DIR/projects/$_init_slug"
    _init_state_dir="$STATE_DIR/$_init_slug"

    _info "Initializing $TOOL for $_target"

    mkdir -p "$_init_cfg_dir" "$_init_state_dir"
    # See _migrate_project for rationale: 0700 protects the OAuth credential
    # file that Claude Code writes inside .claude/ from other local users.
    chmod 700 "$_init_state_dir"

    # config.yml is developer-owned — never overwrite it
    if [ ! -f "$_init_cfg_dir/config.yml" ]; then
        cp "$PROJECT_TEMPLATE" "$_init_cfg_dir/config.yml"
        _detail "created  $CONFIG_DIR/projects/$_init_slug/config.yml"
    else
        _detail "exists   $CONFIG_DIR/projects/$_init_slug/config.yml (skipped)"
    fi

    # Pre-create per-project Claude Code state on the host.
    # Both must exist before Docker mounts them — with read_only: true the
    # container cannot create them at runtime.
    if [ ! -d "$_init_state_dir/.claude" ]; then
        mkdir "$_init_state_dir/.claude"
        _detail "created  $STATE_DIR/$_init_slug/.claude/"
    else
        _detail "exists   $STATE_DIR/$_init_slug/.claude/ (skipped)"
    fi
    chmod 700 "$_init_state_dir/.claude"
    if [ ! -f "$_init_state_dir/.claude.json" ] || [ ! -s "$_init_state_dir/.claude.json" ]; then
        printf '{}' >"$_init_state_dir/.claude.json"
        _detail "created  $STATE_DIR/$_init_slug/.claude.json"
    else
        _detail "exists   $STATE_DIR/$_init_slug/.claude.json (skipped)"
    fi

    _register_project "$_target" "$_init_slug"
    _detail "registered $_target in $PROJECTS_FILE"

    # The blank-line separator before the "NOTE" line is part of the
    # _detail message and should respect the same verbosity gate, not
    # leak through as a stray newline in -q mode.
    if [ "$_VERBOSITY" -ge 1 ] &&
        ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        printf '\n' >&2
        _detail "NOTE: Base image not found. It will be built automatically on first 'connie run'."
    fi

    # The "Next steps" heredoc is part of the same friendly-init UX as
    # the progress messages emitted via _info / _detail. Suppress it at
    # the same verbosity threshold for consistency — a script wrapping
    # `connie -q init` shouldn't have to filter out a trailing block of
    # instructions either.
    if [ "$_VERBOSITY" -ge 1 ]; then
        cat >&2 <<INITEOF

==> Next steps:
    1. Edit $CONFIG_DIR/projects/$_init_slug/config.yml
    2. Run 'connie run' from the project directory

    On first run, Claude Code will prompt you to authenticate.
    Credentials are stored in $STATE_DIR/$_init_slug/
    and reused on subsequent runs for this project.

INITEOF
    fi
}

cmd_build() {
    _project_root=$(_find_project_root "${1:-$PWD}")
    _info "Building project container for $_project_root"
    _merged=$(_mktemp)
    _override=$(_mktemp)
    # EXIT trap fires on every termination path (normal exit, _die,
    # uncaught signal that propagates via the INT/TERM handlers below).
    # The signal handlers print a friendly "Interrupted." / "Terminated."
    # so the user knows the exit was deliberate and not a crash, then
    # exit with the conventional signal-derived code (128 + signum) which
    # causes the EXIT trap to fire and remove the temp files.
    trap 'rm -f "$_merged" "$_override"' EXIT
    trap '_info "Interrupted. Cleaning up."; exit 130' INT
    trap '_info "Terminated. Cleaning up."; exit 143' TERM
    _prepare "$_project_root" "$_merged"
    _generate_override "$_project_root" "$_merged" \
        "$_ARG_PACKAGES" "$_ARG_ENV" "$_ARG_CMD" >"$_override"
    _run_compose "$_project_root" "$_override" build workspace
}

cmd_run() {
    _project_root=$(_find_project_root "${1:-$PWD}")
    _info "Starting Claude Code for $_project_root"
    _merged=$(_mktemp)
    _override=$(_mktemp)
    # See cmd_build for the EXIT/INT/TERM trap rationale.
    trap 'rm -f "$_merged" "$_override"' EXIT
    trap '_info "Interrupted. Cleaning up."; exit 130' INT
    trap '_info "Terminated. Cleaning up."; exit 143' TERM
    _prepare "$_project_root" "$_merged"
    # _generate_override embeds the connie (managed-policy) context as a build
    # arg; user-level context is assembled fresh from host files at run time.
    _generate_override "$_project_root" "$_merged" \
        "$_ARG_PACKAGES" "$_ARG_ENV" "$_ARG_CMD" >"$_override"
    _write_user_context "$_project_root"
    _run_compose "$_project_root" "$_override" build workspace
    # Auto-detect non-interactive contexts (CI, output-redirected, piped
    # stdin) and pass `-T` to skip TTY allocation. The compose file's
    # `tty: true` is the right default for interactive Claude Code usage,
    # but if stdout isn't a TTY, docker compose will refuse with "the
    # input device is not a TTY". Detecting this at invocation time lets
    # connie run work the same in both contexts.
    _tty_flag=""
    [ -t 1 ] || _tty_flag="-T"
    # shellcheck disable=SC2086 # _tty_flag is intentionally word-split
    _run_compose "$_project_root" "$_override" run --rm $_tty_flag workspace
}

cmd_clean() {
    _project_root=$(_find_project_root "${1:-$PWD}")

    _require_yq

    _require_project_config "$_project_root"

    _require docker

    _info "Removing project container image for $_project_root"
    docker compose \
        -p "$(_compose_project_name "$_project_root")" \
        -f "$LIB_DIR/docker/docker-compose.yml" \
        down --rmi local
    _info "Done."
}

# Remove all connie-owned state for a project. The inverse of
# `cmd_init` (which scaffolds) plus `cmd_clean` (which removes the
# image). Five assets, removed in dependency order so a partial
# failure leaves the registry pointing at recoverable state:
#
#   1. Docker image      (`connie-<slug>-workspace`)
#   2. Docker network    (`connie-<slug>_default`)
#   3. State dir         (`$STATE_DIR/<slug>/`     — Claude Code OAuth + history)
#   4. Config dir        (`$CONFIG_DIR/projects/<slug>/`)
#   5. Registry entry    (`$PROJECTS_FILE` → path→slug mapping)
#
# Project directory under /workspace is NEVER touched. The five
# assets above are all connie-owned; the project's own source tree
# is the user's.
#
# Flags:
#   --yes          skip the y/N confirmation (required in non-TTY)
#   --keep-state   preserve the state dir (keeps OAuth + history)
#   --keep-image   skip Docker image + network removal
#   --dry-run      print what would be removed; touch nothing
cmd_remove() {
    _project_root=$(_find_project_root "${1:-$PWD}")
    _rm_slug=$(_project_slug "$_project_root")
    _rm_config_dir="$CONFIG_DIR/projects/$_rm_slug"
    _rm_state_dir="$STATE_DIR/$_rm_slug"
    _rm_compose_proj=$(_compose_project_name "$_project_root")
    _rm_image="${_rm_compose_proj}-workspace"
    _rm_network="${_rm_compose_proj}_default"

    # Build the description of what we'd remove. Used both for
    # --dry-run output and the confirmation prompt so the user sees
    # the same thing in both cases.
    printf '\n' >&2
    printf 'For project: %s (slug: %s)\n' "$_project_root" "$_rm_slug" >&2
    printf '\n' >&2
    if [ "$_ARG_KEEP_IMAGE" != "1" ]; then
        printf '  - Docker image:    %s\n' "$_rm_image" >&2
        printf '  - Docker network:  %s\n' "$_rm_network" >&2
    fi
    if [ "$_ARG_KEEP_STATE" != "1" ]; then
        printf '  - State dir:       %s\n' "$_rm_state_dir" >&2
        printf '                       (Claude Code OAuth tokens + conversation history)\n' >&2
    fi
    printf '  - Config dir:      %s\n' "$_rm_config_dir" >&2
    printf '  - Registry entry:  %s\n' "$PROJECTS_FILE" >&2
    printf '\n' >&2

    if [ "$_ARG_DRY_RUN" = "1" ]; then
        printf '(dry run — nothing removed; re-run without --dry-run to proceed)\n' >&2
        return 0
    fi

    if [ "$_ARG_YES" != "1" ]; then
        if [ ! -t 0 ]; then
            _die "remove needs --yes when stdin isn't a terminal (non-interactive context)." \
                "Add --yes to confirm, or run interactively."
        fi
        _confirm "This is irreversible. Proceed?" || _die "Aborted."
    fi

    # ── 1 + 2: Docker image + network (skipped under --keep-image
    # OR if docker isn't available — better to make best-effort
    # removal than fail the whole command on a missing prerequisite).
    if [ "$_ARG_KEEP_IMAGE" != "1" ]; then
        if command -v docker >/dev/null 2>&1; then
            _info "Removing Docker image and network"
            docker compose -p "$_rm_compose_proj" \
                -f "$LIB_DIR/docker/docker-compose.yml" \
                down --rmi local >/dev/null 2>&1 || true
            docker network rm "$_rm_network" >/dev/null 2>&1 || true
        else
            _detail "docker not on PATH — skipping image/network removal"
        fi
    fi

    # ── 3: State dir. Contains OAuth + per-project history — the
    # asset that earned the confirmation prompt above. Skipped under
    # --keep-state (the "keep me logged in" escape hatch).
    if [ "$_ARG_KEEP_STATE" != "1" ] && [ -d "$_rm_state_dir" ]; then
        _info "Removing state dir: $_rm_state_dir"
        rm -rf "$_rm_state_dir"
    fi

    # ── 4: Config dir. Recreatable via `connie init`, no
    # irreversible loss.
    if [ -d "$_rm_config_dir" ]; then
        _info "Removing config dir: $_rm_config_dir"
        rm -rf "$_rm_config_dir"
    fi

    # ── 5: Registry entry. Last so a mid-run failure above leaves
    # the registry pointing at the (partial) state for diagnosis.
    if [ -f "$PROJECTS_FILE" ]; then
        _info "Removing registry entry"
        _unregister_project "$_project_root"
    fi

    _info "Removed."
}

# ── List ───────────────────────────────────────────────────────────────────
#
# `connie list` enumerates the workspaces connie knows about — every
# project registered in $PROJECTS_FILE by `connie init`/`run`. Prints
# one absolute project path per line to stdout, sorted, so the output
# pipes cleanly (e.g. `connie list | while read d; do …; done`). The
# registry is the single source of truth; a legacy .connie/ project that
# was never migrated won't appear until its next `connie run` registers
# it. Empty-state notes go to stderr, keeping stdout a clean list.
cmd_list() {
    _require_yq

    # Empty or absent registry is not an error: keep stdout an empty,
    # pipe-safe list and explain on stderr. Exit 0 either way.
    _list_paths=""
    [ -f "$PROJECTS_FILE" ] &&
        _list_paths=$(yq 'keys | .[]' "$PROJECTS_FILE" 2>/dev/null | LC_ALL=C sort)

    if [ -z "$_list_paths" ]; then
        _info "No workspaces registered yet."
        _detail "Run '$TOOL init [dir]' to initialize one."
        return 0
    fi

    printf '%s\n' "$_list_paths"
}

# ── Edit ─────────────────────────────────────────────────────────────────────
#
# `connie edit` opens a config file in the user's editor and validates what
# they save. Two scopes, mirroring the rest of the CLI's [dir] grammar:
#
#   connie edit [dir]   the project's config (must be initialized first)
#   connie edit --user  the user-global config (created from a template if
#                       absent — it is the one config layer no other command
#                       scaffolds)
#
# The per-project path embeds a cksum-derived slug, so it is effectively
# unguessable by hand; `edit` is how a user reaches it without copying the
# path out of `connie config`. Validation runs after a successful editor
# exit and leaves the file exactly as saved even when it rejects it — connie
# reports the problem rather than discarding the user's work.

# Resolve the editor ($VISUAL, then $EDITOR, then vi) and open <file>. The
# editor value may carry arguments (e.g. "code --wait"), so the expansion is
# deliberately word-split. Returns the editor's own exit status.
_launch_editor() {
    _le_editor="${VISUAL:-${EDITOR:-vi}}"
    # shellcheck disable=SC2086 # $_le_editor may include args; intentional split
    $_le_editor "$1"
}

# Sanity-check a config file the user just edited. Contract:
#   unparseable YAML            → error on stderr, return 1
#   top-level map               → ok; warn (still return 0) on unknown keys
#   top-level null / empty      → ok (a fully-commented file is a valid no-op)
#   top-level scalar / sequence → error on stderr, return 1
# The file itself is never modified — connie only reports.
_validate_config_file() {
    _vcf_path="$1"

    # `yq tag` exits non-zero on a YAML parse error. Capture inside `if !` so
    # `set -e` doesn't abort before we can print a friendly message.
    if ! _vcf_tag=$(yq 'tag' "$_vcf_path" 2>/dev/null); then
        printf 'error: %s is not valid YAML; left as you saved it.\n' "$_vcf_path" >&2
        return 1
    fi

    case "$_vcf_tag" in
        '!!map') ;;
        '!!null')
            # Empty or all-comments: contributes nothing to the merge. Fine.
            return 0
            ;;
        *)
            printf 'error: %s must be a mapping of config keys (got %s); left as you saved it.\n' \
                "$_vcf_path" "${_vcf_tag#!!}" >&2
            return 1
            ;;
    esac

    # Map case: warn (but don't fail) on keys connie doesn't recognize, so a
    # typo'd `resorces:` is caught now instead of silently doing nothing. The
    # `keys` query is safe here because the tag is known to be !!map. Piping
    # into `while read` avoids word-splitting the key list. The allowed set is
    # the complete list of top-level keys connie consumes (see defaults.yml).
    _vcf_allowed=" packages build_commands env resources ports unsafe_extra_mounts start_cmd "
    yq 'keys | .[]' "$_vcf_path" 2>/dev/null | while IFS= read -r _vcf_key; do
        case "$_vcf_allowed" in
            *" $_vcf_key "*) ;;
            *)
                printf 'warning: %s: unknown config key %s (connie will ignore it)\n' \
                    "$_vcf_path" "$_vcf_key" >&2
                ;;
        esac
    done

    return 0
}

cmd_edit() {
    _require_yq

    if [ "$_ARG_USER" = "1" ]; then
        [ -z "${1:-}" ] ||
            _die "'$TOOL edit --user' takes no directory argument." \
                "Use '$TOOL edit --user' for your user config, or '$TOOL edit [dir]' for a project."
        mkdir -p "$CONFIG_DIR"
        # Same scaffolding strategy as cmd_init: ship a template, copy it in
        # only when absent, never clobber. The user-global config is the one
        # layer no other command creates.
        if [ ! -f "$USER_CONFIG" ]; then
            cp "$USER_TEMPLATE" "$USER_CONFIG"
            _detail "created  $USER_CONFIG"
        fi
        _edit_cfg="$USER_CONFIG"
        _edit_scope="user"
    else
        _edit_root=$(_find_project_root "${1:-$PWD}")
        _require_project_config "$_edit_root"
        _edit_cfg=$(_project_config "$_edit_root")
        _edit_scope="project"
    fi

    _info "Editing $_edit_scope config: $_edit_cfg"

    # `|| { st=$?; }` so the editor's real exit status survives (an `if !`
    # wrapper would reset $? to the negation's result).
    _launch_editor "$_edit_cfg" || {
        _le_status=$?
        _die "Editor exited with status $_le_status; changes (if any) left at $_edit_cfg."
    }

    # Returns non-zero on a hard error, which (under set -e) becomes connie's
    # exit status; the file is left as the user saved it either way.
    _validate_config_file "$_edit_cfg"
}

cmd_config() {
    _project_root=$(_find_project_root "${1:-$PWD}")

    _require_yq

    _require_project_config "$_project_root"
    _cfg=$(_project_config "$_project_root")

    _info "Project:  $_project_root"
    _info "Config:   $_cfg"
    _info "State:    $(_project_state_dir "$_project_root")"
    printf '\n' >&2

    _merged=$(_mktemp)
    trap 'rm -f "$_merged"' EXIT
    _merge_configs "$_project_root" >"$_merged"
    _generate_override "$_project_root" "$_merged" \
        "$_ARG_PACKAGES" "$_ARG_ENV" "$_ARG_CMD"
}

cmd_context() {
    _project_root=$(_find_project_root "${1:-$PWD}")

    _require_yq

    _require_project_config "$_project_root"

    _merged=$(_mktemp)
    trap 'rm -f "$_merged"' EXIT
    _merge_configs "$_project_root" >"$_merged"

    _ctx_preview_header "$_project_root"

    _ctx_scope_header 1 "Managed-policy" "/etc/claude-code/CLAUDE.md" \
        "Generated by connie from the merged config; baked into the image."
    _generate_connie_context "$_project_root" "$_merged"

    # shellcheck disable=SC2088 # literal display path, not for shell expansion
    _ctx_scope_header 2 "User-level" "~/.claude/CLAUDE.md" \
        "Assembled by connie from host /etc/claude-code/CLAUDE.md and ~/.claude/CLAUDE.md."
    _user_ctx=$(_emit_user_context)
    if [ -n "$_user_ctx" ]; then
        printf '%s\n' "$_user_ctx"
    else
        printf '<!-- (empty: neither host source file exists) -->\n'
    fi

    _ctx_scope_header 3 "Project" "/workspace/CLAUDE.md and /workspace/.claude/CLAUDE.md" \
        "Read by Claude Code directly from the project directory; connie never writes here."
    _proj_ctx=$(_emit_project_context "$_project_root")
    if [ -n "$_proj_ctx" ]; then
        printf '%s\n' "$_proj_ctx"
    else
        printf '<!-- (empty: no CLAUDE.md in project root) -->\n'
    fi

    _ctx_scope_header 4 "Local" "/workspace/CLAUDE.local.md" \
        "Read by Claude Code directly from the project directory; connie never writes here."
    _local_ctx=$(_emit_local_context "$_project_root")
    if [ -n "$_local_ctx" ]; then
        printf '%s\n' "$_local_ctx"
    else
        printf '<!-- (empty: no CLAUDE.local.md in project root) -->\n'
    fi

    _ctx_preview_footer
}

# ── Doctor ───────────────────────────────────────────────────────────────────
#
# `connie doctor` runs a series of diagnostics across required tools,
# connie installation, base image, and (optionally) per-project state.
# Each check reports `ok`, `warn`, or `fail` plus an actionable hint
# on non-ok results. Exits 0 if no failures, 1 if any failed (warnings
# don't fail the run).
#
# This is the command a user runs FIRST when something isn't working
# right — it surfaces the misconfiguration directly instead of letting
# a later `connie run` discover it through a less-friendly error path.

# Print a section header in the doctor output.
_doctor_section() {
    printf '\n%s\n' "$1" >&2
}

# Pass a check from a non-zero-exit-status command without an
# intermediate variable. Increments _doc_passed.
_doctor_pass() {
    printf '  ok    %s\n' "$1" >&2
    _doc_passed=$((_doc_passed + 1))
}

# Warn — non-failing, but worth flagging with a hint.
_doctor_warn() {
    printf '  warn  %s\n' "$1" >&2
    [ -n "${2:-}" ] && printf '        %s\n' "$2" >&2
    _doc_warned=$((_doc_warned + 1))
}

# Fail — counts toward the non-zero exit at end of run.
_doctor_fail() {
    printf '  fail  %s\n' "$1" >&2
    [ -n "${2:-}" ] && printf '        %s\n' "$2" >&2
    _doc_failed=$((_doc_failed + 1))
}

# Run a check: NAME HINT command [args...]. Redirects the command's
# stdout and stderr to /dev/null so the diagnostic output stays clean.
# Hint shows only on failure.
_doctor_check() {
    _dc_name="$1"
    _dc_hint="$2"
    shift 2
    if "$@" >/dev/null 2>&1; then
        _doctor_pass "$_dc_name"
    else
        _doctor_fail "$_dc_name" "$_dc_hint"
    fi
}

# yq-v4 sniff (the same one _require_yq uses).
_doctor_check_yq_v4() {
    yq eval-all 'null' /dev/null
}

cmd_doctor() {
    _doc_target="${1:-$PWD}"
    _doc_failed=0
    _doc_warned=0
    _doc_passed=0

    _info "Running connie diagnostics"

    _doctor_section "Required tools:"
    _doctor_check "docker on PATH" \
        "Install Docker Engine 24+ — https://docs.docker.com/engine/install/" \
        command -v docker
    _doctor_check "docker daemon reachable" \
        "Start the daemon (e.g. 'sudo systemctl start docker')" \
        docker info
    _doctor_check "yq on PATH" \
        "Install yq v4 — https://github.com/mikefarah/yq#install" \
        command -v yq
    _doctor_check "yq is v4 (mikefarah)" \
        "Installed yq doesn't support 'eval-all'; install v4 from mikefarah/yq" \
        _doctor_check_yq_v4

    _doctor_section "Connie installation:"
    _doctor_check "lib dir present ($LIB_DIR)" \
        "Reinstall: make install PREFIX=~/.local" \
        test -d "$LIB_DIR"
    _doctor_check "defaults.yml present" \
        "Reinstall: make install (defaults.yml is shipped, not user-edited)" \
        test -f "$LIB_DIR/config/defaults.yml"
    _doctor_check "base.Dockerfile present" \
        "Reinstall: make install" \
        test -f "$LIB_DIR/docker/base.Dockerfile"
    _doctor_check "extend.Dockerfile present" \
        "Reinstall: make install" \
        test -f "$LIB_DIR/docker/extend.Dockerfile"
    _doctor_check "docker-compose.yml present" \
        "Reinstall: make install" \
        test -f "$LIB_DIR/docker/docker-compose.yml"
    _doctor_check "entrypoint.sh present" \
        "Reinstall: make install" \
        test -f "$LIB_DIR/docker/entrypoint.sh"

    _doctor_section "Base image:"
    if docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
        _doctor_pass "base image $BASE_IMAGE present"
    else
        _doctor_warn "base image $BASE_IMAGE not built yet" \
            "Run 'connie build-base' (or let 'connie run' build it on first use)"
    fi

    # Per-project section, only meaningful when the target exists.
    # Walking up the tree the way _find_project_root does is too
    # surprising here ("doctor reported on my parent project, not the
    # one I was asking about"); just check the exact path passed in.
    if [ -d "$_doc_target" ]; then
        _doc_project_root=$(cd "$_doc_target" 2>/dev/null && pwd)
        _doc_config_path=$(_project_config "$_doc_project_root")
        _doc_state_path=$(_project_state_dir "$_doc_project_root")

        _doctor_section "Project ($_doc_project_root):"
        if [ -f "$_doc_config_path" ]; then
            _doctor_pass "config present: $_doc_config_path"
            _doctor_check "config parses as YAML" \
                "yq could not parse the config; check for syntax errors" \
                yq eval-all 'null' "$_doc_config_path"
        else
            _doctor_warn "no project config yet" \
                "Run 'connie init $_doc_target' to scaffold one"
        fi
        if [ -d "$_doc_state_path" ]; then
            # 0700 is the documented permission (defense-in-depth on
            # the OAuth bearer token). `find -perm 700` is the POSIX
            # way to test exact mode bits — `stat -c` and `stat -f`
            # formats differ between GNU coreutils and BSD; `ls -ld`
            # parsing trips shellcheck SC2012.
            if find "$_doc_state_path" -maxdepth 0 -type d -perm 700 \
                2>/dev/null | grep -q .; then
                _doctor_pass "state dir mode 700: $_doc_state_path"
            else
                _doctor_warn "state dir not mode 700: $_doc_state_path" \
                    "Run 'chmod 700 \"$_doc_state_path\"' to harden"
            fi
        else
            _doctor_warn "no state dir yet (created on first 'connie init' or 'connie run')" \
                "$_doc_state_path"
        fi
    fi

    # Final summary. Always emit, even at -q — this command's whole
    # purpose is producing output, so suppressing it would defeat it.
    printf '\n' >&2
    if [ "$_doc_failed" -gt 0 ]; then
        printf 'Diagnostics: %d passed, %d warnings, %d failed.\n' \
            "$_doc_passed" "$_doc_warned" "$_doc_failed" >&2
        exit 1
    elif [ "$_doc_warned" -gt 0 ]; then
        printf 'Diagnostics: %d passed, %d warnings.\n' \
            "$_doc_passed" "$_doc_warned" >&2
    else
        printf 'Diagnostics: all %d checks passed.\n' "$_doc_passed" >&2
    fi
}

# ── Main: argument parsing and dispatch ──────────────────────────────────────
#
# Wrapped in a function so the test harness can source this script for its
# function definitions without triggering the CLI. The entry-point line at
# the bottom of the file calls _main unless CONNIE_NO_DISPATCH=1 is set.

_main() {
    _ARG_PACKAGES=""
    _ARG_ENV=""
    _ARG_CMD=""
    # Flags scoped to `remove` (see cmd_remove for semantics).
    _ARG_YES=0
    _ARG_KEEP_STATE=0
    _ARG_KEEP_IMAGE=0
    _ARG_DRY_RUN=0
    # Flag scoped to `edit`: target the user-global config instead of a project.
    _ARG_USER=0
    _SUBCOMMAND=""
    _TARGET_DIR=""

    # Seed verbosity from env. CLI flags below override. Env-var form
    # is the common shape for connie's other overrides (CONNIE_BASE_IMAGE,
    # CONNIE_LIB_DIR, …) and is convenient for scripts that prefer not
    # to thread a flag through every invocation.
    if [ "${CONNIE_QUIET:-0}" = "1" ]; then
        _VERBOSITY=0
    elif [ "${CONNIE_VERBOSE:-0}" = "1" ]; then
        _VERBOSITY=2
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            init | run | build | clean | remove | config | edit | context | doctor | list | help | version)
                _SUBCOMMAND="$1"
                shift
                ;;
            build-base)
                _SUBCOMMAND="build-base"
                shift
                ;;
            -q | --quiet)
                _VERBOSITY=0
                shift
                ;;
            -v | --verbose)
                _VERBOSITY=2
                shift
                ;;
            --package)
                [ $# -ge 2 ] || _die "--package requires an argument"
                _ARG_PACKAGES="${_ARG_PACKAGES:+$_ARG_PACKAGES }$2"
                shift 2
                ;;
            --env)
                [ $# -ge 2 ] || _die "--env requires an argument"
                # Newline-delimited so IFS-splitting in _build_cli_env_obj
                # handles values that contain spaces. The literal newline is
                # intentional.
                _ARG_ENV="${_ARG_ENV:+$_ARG_ENV
}$2"
                shift 2
                ;;
            --cmd)
                [ $# -ge 2 ] || _die "--cmd requires an argument"
                _ARG_CMD="$2"
                shift 2
                ;;
            --yes)
                _ARG_YES=1
                shift
                ;;
            --keep-state)
                _ARG_KEEP_STATE=1
                shift
                ;;
            --keep-image)
                _ARG_KEEP_IMAGE=1
                shift
                ;;
            --dry-run)
                _ARG_DRY_RUN=1
                shift
                ;;
            --user)
                _ARG_USER=1
                shift
                ;;
            --version)
                printf '%s %s\n' "$TOOL" "$VERSION"
                exit 0
                ;;
            -*)
                _die "Unknown flag: $1" "Run '$TOOL help' for usage."
                ;;
            *)
                [ -z "$_TARGET_DIR" ] ||
                    _die "Unexpected argument: $1" "Run '$TOOL help' for usage."
                _TARGET_DIR="$1"
                shift
                ;;
        esac
    done

    case "${_SUBCOMMAND:-help}" in
        init) cmd_init "${_TARGET_DIR:-}" ;;
        build) cmd_build "${_TARGET_DIR:-}" ;;
        build-base) cmd_build_base ;;
        run) cmd_run "${_TARGET_DIR:-}" ;;
        clean) cmd_clean "${_TARGET_DIR:-}" ;;
        remove) cmd_remove "${_TARGET_DIR:-}" ;;
        config) cmd_config "${_TARGET_DIR:-}" ;;
        edit) cmd_edit "${_TARGET_DIR:-}" ;;
        context) cmd_context "${_TARGET_DIR:-}" ;;
        doctor) cmd_doctor "${_TARGET_DIR:-}" ;;
        list) cmd_list ;;
        version) printf '%s %s\n' "$TOOL" "$VERSION" ;;
        help)
            # If we landed here because the first positional argument didn't
            # match any known subcommand, surface the error rather than
            # silently showing usage — the user almost certainly typo'd a
            # command name.
            [ -z "$_TARGET_DIR" ] ||
                _die "Unknown command: $_TARGET_DIR" "Run '$TOOL help' for usage."
            _usage
            ;;
    esac
}

# ── Entry point ──────────────────────────────────────────────────────────────
# Skipped when CONNIE_NO_DISPATCH=1 — the test harness sources this script to
# get the function definitions without triggering the CLI.

[ "${CONNIE_NO_DISPATCH:-0}" = "1" ] || _main "$@"
